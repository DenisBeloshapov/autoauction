// AutoAuction — единая production-схема (PostgreSQL / Neon / Vercel).
// Это ЕДИНСТВЕННЫЙ файл схемы в проекте — ранее существовал ещё и
// дублирующий schema.prisma в корне репозитория, который Prisma CLI на
// Vercel читал ВМЕСТО этого файла (см. build-логи: "Prisma schema loaded
// from schema.prisma"), из-за чего фиксы в этот файл месяцами не долетали
// до продакшена, хотя визуально всё выглядело правильно. Корневой файл
// удалён. Не создавайте его заново — все команды prisma (см. package.json)
// теперь ещё и явно указывают --schema=./prisma/schema.prisma на всякий
// случай, но лучше просто не плодить второй файл схемы.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // bcrypt hash
  name      String?
  email     String?
  role      String   @default("CLIENT") // ADMIN | CLIENT
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots         Lot[]
  deliveryReqs DeliveryRequest[]
}

model Lot {
  id           String   @id @default(cuid())
  lotNumber    String
  rawText      String?
  auctionName  String   @default("")
  carMake      String   @default("")
  carModel     String?
  auctionDate  String   @default("")
  comment      String?
  status       String   @default("PENDING") // PENDING | SENT | WON
  clientId     String
  emailBatchId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client     User        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  emailBatch EmailBatch? @relation(fields: [emailBatchId], references: [id])
  wonLot     WonLot?

  @@index([clientId])
  @@index([status])
  @@index([lotNumber])
}

model WonLot {
  id         String   @id @default(cuid())
  lotId      String   @unique
  price      Float?
  currency   String   @default("JPY")
  status     String   @default("WON") // WON | DELIVERY_REQUESTED | DELIVERY_CONFIRMED | COMPLETED
  bodyNumber String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lot          Lot               @relation(fields: [lotId], references: [id], onDelete: Cascade)
  deliveryReqs DeliveryRequest[]
}

model DeliveryRequest {
  id            String   @id @default(cuid())
  wonLotId      String
  clientId      String
  method        String? // DUTY | DISASSEMBLY | CUT_REAR | CUT_FRONT | CUT_REAR_ARCS
  ownerFullName String?
  ownerAddress  String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wonLot WonLot @relation(fields: [wonLotId], references: [id], onDelete: Cascade)
  client User   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([wonLotId])
  @@index([clientId])
}

model EmailBatch {
  id             String   @id @default(cuid())
  subject        String
  recipientEmail String
  body           String
  comment        String?
  sentAt         DateTime @default(now())

  lots Lot[]
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  updatedAt DateTime @updatedAt
}
