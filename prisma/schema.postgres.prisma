// AutoAuction — schema v1.0 (PostgreSQL для продакшена на Vercel/Neon)
// Скопируйте этот файл в prisma/schema.prisma перед миграцией на PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // bcrypt hash
  name      String?
  email     String?
  role      String   @default("CLIENT") // ADMIN | CLIENT
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots         Lot[]
  deliveryReqs DeliveryRequest[]
}

model Lot {
  id           String   @id @default(cuid())
  lotNumber    String
  rawText      String?
  auctionName  String   @default("")
  carMake      String   @default("")
  carModel     String?
  auctionDate  String   @default("")
  comment      String?
  status       String   @default("PENDING")
  clientId     String
  emailBatchId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client     User         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  emailBatch EmailBatch? @relation(fields: [emailBatchId], references: [id])
  wonLot     WonLot?

  @@index([clientId])
  @@index([status])
  @@index([lotNumber])
}

model WonLot {
  id         String   @id @default(cuid())
  lotId      String   @unique
  price      Float?
  currency   String   @default("JPY")
  bodyNumber String?
  status     String   @default("WON")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lot          Lot              @relation(fields: [lotId], references: [id], onDelete: Cascade)
  deliveryReqs DeliveryRequest[]
}

model DeliveryRequest {
  id            String   @id @default(cuid())
  wonLotId      String
  clientId      String
  method        String?
  ownerFullName String?
  ownerAddress  String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wonLot WonLot @relation(fields: [wonLotId], references: [id], onDelete: Cascade)
  client User   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([wonLotId])
  @@index([clientId])
}

model EmailBatch {
  id             String   @id @default(cuid())
  subject        String
  recipientEmail String
  body           String
  comment        String?
  sentAt         DateTime @default(now())

  lots Lot[]
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  updatedAt DateTime @updatedAt
}
